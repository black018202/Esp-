-- Serviços necessários
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Configurações (Começa desativado)
local espEnabled = false 
local TOGGLE_KEY = Enum.KeyCode.Equals -- Tecla '=' / '+'

-- Tabela para armazenar os desenhos (ESP) de cada jogador
local espCache = {}

-- Função para criar a estrutura visual de um jogador
local function createESP(player)
	if player == LocalPlayer then return end

	local espData = {}

	-- Box (Retângulo roxo com borda um pouco mais grossa)
	local box = Drawing.new("Square")
	box.Visible = false
	box.Color = Color3.fromRGB(138, 43, 226) -- Roxo
	box.Thickness = 2.5
	box.Filled = false
	espData.Box = box

	-- Nick em cima (Branco)
	local nameText = Drawing.new("Text")
	nameText.Visible = false
	nameText.Color = Color3.fromRGB(255, 255, 255) -- Branco
	nameText.Size = 14
	nameText.Center = true
	nameText.Outline = true
	espData.NameText = nameText

	-- Fundo da Barra de Vida (Preto/Cinza escuro)
	local healthBarBg = Drawing.new("Square")
	healthBarBg.Visible = false
	healthBarBg.Color = Color3.fromRGB(0, 0, 0)
	healthBarBg.Thickness = 1
	healthBarBg.Filled = true
	espData.HealthBarBg = healthBarBg

	-- Barra de Vida Dinâmica (Verde/Amarelo/Vermelho)
	local healthBar = Drawing.new("Square")
	healthBar.Visible = false
	healthBar.Thickness = 1
	healthBar.Filled = true
	espData.HealthBar = healthBar

	espCache[player] = espData
end

-- Função para remover o ESP quando o jogador sair
local function removeESP(player)
	if espCache[player] then
		for _, drawing in pairs(espCache[player]) do
			drawing:Remove()
		end
		espCache[player] = nil
	end
end

-- Inicializar para jogadores já presentes
for _, player in ipairs(Players:GetPlayers()) do
	createESP(player)
end

Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- Sistema de ativação/desativação pela tecla
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == TOGGLE_KEY then
		espEnabled = not espEnabled
		if not espEnabled then
			for _, espData in pairs(espCache) do
				espData.Box.Visible = false
				espData.NameText.Visible = false
				espData.HealthBarBg.Visible = false
				espData.HealthBar.Visible = false
			end
		end
	end
end)

-- Loop principal de renderização do ESP
RunService.RenderStepped:Connect(function()
	if not espEnabled then return end

	for player, espData in pairs(espCache) do
		-- Garante que nunca vai renderizar no próprio jogador
		if player ~= LocalPlayer then
			local character = player.Character
			local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local head = character and character:FindFirstChild("Head")

			if character and humanoidRootPart and head and humanoid and humanoid.Health > 0 then
				local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
				local rootPos, onScreen = Camera:WorldToViewportPoint(humanoidRootPart.Position)

				if onScreen or headOnScreen then
					local legPosition = Camera:WorldToViewportPoint(humanoidRootPart.Position - Vector3.new(0, 3.2, 0))
					
					-- Altura e largura com o ajuste de tamanho proporcional
					local height = math.abs(headPos.Y - legPosition.Y) * 1.15
					local width = (height / 2) * 1.15

					local boxPosition = Vector2.new(headPos.X - width / 2, headPos.Y)

					-- Atualizar Box Roxo
					local box = espData.Box
					box.Size = Vector2.new(width, height)
					box.Position = boxPosition
					box.Visible = true

					-- Configurações da Barra de Vida (Descolada um pouco para cima da borda do box)
					local barWidth = width
					local barHeight = 4
					local barX = boxPosition.X
					local barY = boxPosition.Y - 8

					-- Fundo da barra
					local healthBarBg = espData.HealthBarBg
					healthBarBg.Size = Vector2.new(barWidth, barHeight)
					healthBarBg.Position = Vector2.new(barX, barY)
					healthBarBg.Visible = true

					-- Porcentagem de vida atual
					local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
					local currentBarWidth = barWidth * healthPercent

					-- Definir cor da barra com base na vida (Verde -> Amarelo -> Vermelho)
					local healthBar = espData.HealthBar
					healthBar.Size = Vector2.new(currentBarWidth, barHeight - 1)
					healthBar.Position = Vector2.new(barX, barY)
					
					if healthPercent > 0.6 then
						healthBar.Color = Color3.fromRGB(0, 255, 0) -- Verde
					elseif healthPercent > 0.3 then
						healthBar.Color = Color3.fromRGB(255, 255, 0) -- Amarelo
					else
						healthBar.Color = Color3.fromRGB(255, 0, 0) -- Vermelho
					end
					healthBar.Visible = true

					-- Atualizar Nick (Mais para cima, logo acima da barra de vida)
					local nameText = espData.NameText
					nameText.Text = player.Name
					nameText.Position = Vector2.new(boxPosition.X + (width / 2), barY - 18)
					nameText.Visible = true
				else
					espData.Box.Visible = false
					espData.NameText.Visible = false
					espData.HealthBarBg.Visible = false
					espData.HealthBar.Visible = false
				end
			else
				espData.Box.Visible = false
				espData.NameText.Visible = false
				espData.HealthBarBg.Visible = false
				espData.HealthBar.Visible = false
			end
		end
	end
end)
