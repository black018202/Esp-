local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local camlockAtivo = false
local target = nil

-- Controla a suavidade dinâmica (Alpha do Lerp)
local suavidadeAtual = 0.05 

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Camera = workspace.CurrentCamera
end)

-- ==================== CONFIGURAÇÕES ====================
local SUAVE_MIRA = 0.26        -- Mantido em 0.26 conforme solicitado
local DISTANCIA_MAXIMA = 500    
local ANGULO_VISAO = 0.85      -- Ignora quem está muito nas laterais da tela
local NICK_IGNORADO = "paulinhobry5" 
-- =======================================================

local function getClosestPlayerToCenterOfScreen()
    local bestTarget = nil
    local closestDistance = math.huge
    local camPos = Camera.CFrame.Position
    local camLook = Camera.CFrame.LookVector

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Name ~= NICK_IGNORADO then
            local character = player.Character
            local hrp = character:FindFirstChild("HumanoidRootPart")
            local head = character:FindFirstChild("Head")
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            
            -- Aceita jogadores vivos (mesmo que estejam sentados)
            if hrp and head and humanoid and humanoid.Health > 0 then
                -- FILTRO DE ALTURA: Evita puxar em alvos voando ou muito abaixo
                local alturaDiff = math.abs(head.Position.Y - camPos.Y)
                if alturaDiff < 45 then 
                    
                    local dist = (hrp.Position - camPos).Magnitude
                    if dist <= DISTANCIA_MAXIMA then
                        local direction = (hrp.Position - camPos).Unit
                        local dot = camLook:Dot(direction)
                        
                        if dot > ANGULO_VISAO then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local viewportSize = Camera.ViewportSize
                                local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
                                local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                                
                                if distFromCenter < closestDistance then
                                    closestDistance = distFromCenter
                                    bestTarget = player
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

local function isTargetAlive(player)
    if not player or not player.Character then return false end
    local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    
    return humanoid and hrp and humanoid.Health > 0
end

-- Loop principal atualizado para a RenderStep da Câmera
RunService:BindToRenderStep("CamlockLoop", Enum.RenderPriority.Camera.Value + 1, function()
    if camlockAtivo then
        -- Se o alvo morreu ou sumiu, reseta e busca outro normalmente
        if target and not isTargetAlive(target) then
            target = nil
            suavidadeAtual = 0.05 
        end

        -- SE NÃO TEM ALVO: Busca quem estiver olhando
        if not target then
            target = getClosestPlayerToCenterOfScreen()
            if target then
                suavidadeAtual = 0.05
            end
        else
            -- SE JÁ TEM ALVO: Ele só vai checar a troca se o alvo atual estiver sentado (Sit)
            local currentHumanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
            if currentHumanoid and currentHumanoid.Sit then
                
                local potentialTarget = getClosestPlayerToCenterOfScreen()
                if potentialTarget and potentialTarget ~= target then
                    local potHumanoid = potentialTarget.Character and potentialTarget.Character:FindFirstChildOfClass("Humanoid")
                    
                    -- Exceção: Se o alvo novo NÃO estiver sentado (está em pé), ele troca para o em pé mais próximo!
                    if potHumanoid and not potHumanoid.Sit then
                        target = potentialTarget
                        suavidadeAtual = 0.05
                    end
                end
            end
        end

        -- Aplica o movimento de câmera (Gruda e não sai ao mexer o mouse)
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head")
            if head then
                local currentCFrame = Camera.CFrame
                local targetCFrame = CFrame.lookAt(currentCFrame.Position, head.Position)
                
                -- Interpolação suave
                Camera.CFrame = currentCFrame:Lerp(targetCFrame, suavidadeAtual)
                
                -- Aproxima gradualmente do limite máximo configurado
                if suavidadeAtual < SUAVE_MIRA then
                    suavidadeAtual = suavidadeAtual + 0.005
                end
            end
        end
    end
end)

-- Ativação pela tecla F
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if not gameProcessedEvent and input.KeyCode == Enum.KeyCode.F then
        camlockAtivo = not camlockAtivo
        target = nil 
        suavidadeAtual = 0.05 -- Começa bem suave ao ligar
        print(camlockAtivo and "Camlock: ATIVADO" or "Camlock: DESATIVADO")
    end
end)
